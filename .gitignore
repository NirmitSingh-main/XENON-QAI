# ==============================================================================
# XENON-QAI Project .gitignore
# ==============================================================================

# 1. Python Cache & Build Artifacts
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
.eggs/

# 2. Virtual Environments
.venv/
venv/
env/
ENV/

# 3. Jupyter Notebook Checkpoints
.ipynb_checkpoints/
*.ipynb_checkpoints

# 4. IDE & OS Metadata
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# 5. Testing & Coverage
.pytest_cache/
.coverage
htmlcov/

# 6. ML Tracking & Execution Logs
mlruns/
wandb/
*.log
experiment_logs/

# 7. Secrets & Environment Files
.env
.env.*
configs/secrets.yaml

# 8. All Plain Text Notes & Working Documents (Strict Exception Rule)
*.txt
!requirements.txt
!requirements-dev.txt

# 9. Large Datasets & Compressed Archives (Never commit raw data)
data/*
!data/.gitkeep
!data/README.md
data/raw/
data/processed/
data/interim/
data/external/
data/extracted/
*.h5
*.hdf5
*.npz
*.npy
*.parquet
*.root
*.tar
*.tar.gz
*.tar.xz
*.tar.bz2
*.zip
*.7z
*.rar
*.dat
*.bin

# 10. Model Checkpoints & Large Binary Embeddings
*.pt
*.pth
*.ckpt

# 11. Intermediate Experiments, Split Manifests & Predictions
results/45k_benchmark/*.pt
results/45k_benchmark/*.npz
results/45k_benchmark/*.json
results/ablation_study/*.json
results/per_class_evaluation/*.json
results/*split_manifest.json
results/predictions/*
!results/predictions/.gitkeep
results/latent_spaces/*
!results/latent_spaces/.gitkeep
results/checkpoints/*
!results/checkpoints/.gitkeep

# 12. Tabular Files Rule (Ignore intermediate/unapproved tabular data)
*.tsv
*.xlsx
*.parquet

# Default: ignore CSVs, EXCEPT approved final research benchmark tables
*.csv
!results/45k_benchmark/45k_benchmark_summary.csv
!results/ablation_study/ablation_summary.csv
!results/per_class_evaluation/per_class_breakdown.csv
!results/25k_benchmark_summary.csv
!results/prior_art_matrix.csv
